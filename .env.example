# Copier vers .env.local (développement) ou renseigner dans l'hébergeur (production).
# Ne jamais committer de valeurs réelles. Les variables NEXT_PUBLIC_* sont visibles dans le navigateur.

# URL publique du site (canonicals, sitemap, liens des emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sanity (catalogue et contenus publics) ---
# Sans projet configuré : catalogue de démonstration en développement, catalogue vide en production.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01
# Secret du webhook Sanity → /api/revalidate (rafraîchissement des pages après publication).
SANITY_REVALIDATE_SECRET=

# --- Supabase (commandes, comptes, tarifs privés) ---
NEXT_PUBLIC_SUPABASE_URL=
# Clé « publishable » (sb_publishable_…) : publique, protégée par les règles RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé « secret » (sb_secret_…) : SERVEUR UNIQUEMENT, contourne la RLS. Jamais préfixée NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Commandes ---
# Secret serveur (32 caractères minimum) : jetons de confirmation et empreintes anti-abus.
# Générer par exemple avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ORDER_TOKEN_SECRET=
